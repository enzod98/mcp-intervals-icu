# Copiar como /etc/intervalsmcp.env en el VPS (fuera del repo) y completar con valores reales.
# El archivo real NUNCA debe versionarse ni tener permisos de lectura para otros usuarios:
#   sudo chmod 600 /etc/intervalsmcp.env

INTERVALS_API_KEY=tu_api_key_de_intervals_icu
INTERVALS_ATHLETE_ID=i12345678

MCP_TRANSPORT=http
# Generar con: openssl rand -hex 32
MCP_AUTH_TOKEN=reemplazar_por_un_token_largo_y_aleatorio

# Kestrel escucha solo en localhost; Caddy expone HTTPS hacia afuera y reenvía para acá.
ASPNETCORE_URLS=http://127.0.0.1:5170
